meta {
  name: MTN Webhook - Transfer Successful
  type: http
  seq: 6
}

post {
  url: http://localhost:5070/webhooks/mtn/transfers/{{mtnReferenceId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
