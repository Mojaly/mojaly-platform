meta {
  name: Griffin Webhook - Submission Delivered
  type: http
  seq: 4
}

post {
  url: http://localhost:5070/webhooks/griffin
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "event-url": "/v0/events/ev.mojaly-griffin-demo-001",
