# ============================================================
# Shared / Compose
# ============================================================

RAFIKI_VERSION=v2.4.5-de

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password

BACKEND_DATABASE_NAME=development
AUTH_DATABASE_NAME=auth_development
KRATOS_DATABASE_NAME=mojaly_kratos

REDIS_URL=redis://redis:6379

TRUST_PROXY=true
LOG_LEVEL=info
NODE_ENV=production

OPERATOR_TENANT_ID=11111111-1111-4111-8111-111111111111


# ============================================================
# Backend Service - Required
# ============================================================

BACKEND_ADMIN_API_SECRET=replace-with-strong-backend-admin-secret

AUTH_SERVICE_API_URL=http://mojaly-rafiki-auth:3011
AUTH_SERVER_GRANT_URL=https://auth.yourdomain.com
AUTH_SERVER_INTROSPECTION_URL=http://mojaly-rafiki-auth:3007

DATABASE_URL=postgresql://postgres:replace-with-strong-postgres-password@postgres:5432/development

OPEN_PAYMENTS_URL=https://pay.yourdomain.com
ILP_CONNECTOR_URL=https://ilp.yourdomain.com
ILP_ADDRESS=g.yourdomain.mojaly

EXCHANGE_RATES_URL=https://pay.yourdomain.com/rates
WEBHOOK_URL=https://api.yourdomain.com/rafiki/webhooks

KEY_ID=mojaly-key-id
USE_TIGERBEETLE=true
STREAM_SECRET=replace-with-base64-stream-secret


# ============================================================
# Backend Service - Optional
# ============================================================

INSTANCE_NAME=mojaly

BACKEND_ADMIN_PORT=3001
OPEN_PAYMENTS_PORT=3000
CONNECTOR_PORT=3002

ADMIN_API_SIGNATURE_TTL_SECONDS=30
ADMIN_API_SIGNATURE_VERSION=1

ENABLE_AUTO_PEERING=false
AUTO_PEERING_SERVER_PORT=3005

ENABLE_MANUAL_MIGRATIONS=false
ENABLE_PARTIAL_PAYMENT_DECISION=false
ENABLE_SPSP_PAYMENT_POINTERS=true
ENABLE_TELEMETRY=false
ENABLE_TELEMETRY_TRACES=false

EXCHANGE_RATES_LIFETIME=15000
QUOTE_LIFESPAN=300000
SLIPPAGE=0.01

INCOMING_PAYMENT_WORKERS=1
INCOMING_PAYMENT_WORKER_IDLE=200
INCOMING_PAYMENT_CREATED_POLL_FREQUENCY_MS=1000
INCOMING_PAYMENT_CREATED_POLL_TIMEOUT_MS=10000
INCOMING_PAYMENT_EXPIRY_MAX_MS=2592000000

OUTGOING_PAYMENT_WORKERS=1
OUTGOING_PAYMENT_WORKER_IDLE=10
MAX_OUTGOING_PAYMENT_RETRY_ATTEMPTS=5

POLL_INCOMING_PAYMENT_CREATED_WEBHOOK=false

GRAPHQL_IDEMPOTENCY_KEY_LOCK_MS=2000
GRAPHQL_IDEMPOTENCY_KEY_TTL_MS=86400000

SEND_TENANT_WEBHOOKS_TO_OPERATOR=true

SIGNATURE_SECRET=replace-with-strong-webhook-signature-secret
SIGNATURE_VERSION=1

TIGERBEETLE_CLUSTER_ID=0
TIGERBEETLE_REPLICA_ADDRESSES=10.5.0.50:4342
TIGERBEETLE_TWO_PHASE_TIMEOUT_SECONDS=5

WALLET_ADDRESS_URL=https://pay.yourdomain.com/mojaly
WALLET_ADDRESS_LOOKUP_TIMEOUT_MS=1500
WALLET_ADDRESS_POLLING_FREQUENCY_MS=100
WALLET_ADDRESS_DEACTIVATION_PAYMENT_GRACE_PERIOD_MS=86400000
WALLET_ADDRESS_WORKERS=1
WALLET_ADDRESS_WORKER_IDLE=200
WALLET_ADDRESS_REDIRECT_HTML_PAGE=

WEBHOOK_TIMEOUT=2000
WEBHOOK_MAX_RETRY=10
WEBHOOK_WORKERS=1
WEBHOOK_WORKER_IDLE=200

WITHDRAWAL_THROTTLE_DELAY=

LIVENET=false

OPEN_TELEMETRY_COLLECTOR_URLS=
OPEN_TELEMETRY_TRACE_COLLECTOR_URLS=
OPEN_TELEMETRY_EXPORT_INTERVAL=15000
TELEMETRY_EXCHANGE_RATES_URL=https://telemetry-exchange-rates.s3.amazonaws.com/exchange-rates-usd.json
TELEMETRY_EXCHANGE_RATES_LIFETIME=86400000


# ============================================================
# Backend Service - Conditionally Required
# ============================================================

DB_ENCRYPTION_SECRET=
PARTIAL_PAYMENT_DECISION_MAX_WAIT_MS=1500
PARTIAL_PAYMENT_DECISION_SAFETY_MARGIN_MS=100


# ============================================================
# Auth Service - Required
# ============================================================

AUTH_ADMIN_API_SECRET=replace-with-strong-auth-admin-secret

AUTH_DATABASE_URL=postgresql://postgres:replace-with-strong-postgres-password@postgres:5432/auth_development
AUTH_SERVER_URL=https://auth.yourdomain.com

COOKIE_KEY=replace-with-strong-cookie-key

IDENTITY_SERVER_URL=https://idp.yourdomain.com
IDENTITY_SERVER_SECRET=replace-with-strong-identity-server-secret


# ============================================================
# Auth Service - Optional
# ============================================================

AUTH_ADMIN_PORT=3003
AUTH_PORT=3006
INTROSPECTION_PORT=3007
INTERACTION_PORT=3009
SERVICE_API_PORT=3011

ACCESS_TOKEN_EXPIRY_SECONDS=600
ACCESS_TOKEN_DELETION_DAYS=30

DATABASE_CLEANUP_WORKERS=1
ENABLE_MANUAL_MIGRATIONS=false

INCOMING_PAYMENT_INTERACTION=false
QUOTE_INTERACTION=false
LIST_ALL_ACCESS_INTERACTION=true

INTERACTION_EXPIRY_SECONDS=600
INTERACTION_COOKIE_SAME_SITE=lax

WAIT_SECONDS=5

REDIS_TLS_CA_FILE_PATH=
REDIS_TLS_CERT_FILE_PATH=
REDIS_TLS_KEY_FILE_PATH=


# ============================================================
# Frontend Service - Required
# ============================================================

FRONTEND_PORT=3005
GRAPHQL_URL=http://mojaly-rafiki-backend:3001/graphql
FRONTEND_OPEN_PAYMENTS_URL=https://pay.yourdomain.com


# ============================================================
# Frontend Service - Conditionally Required
# ============================================================

AUTH_ENABLED=false
KRATOS_ADMIN_URL=http://kratos:4434/admin
KRATOS_BROWSER_PUBLIC_URL=https://admin.yourdomain.com/kratos
KRATOS_CONTAINER_PUBLIC_URL=http://kratos:4433


# ============================================================
# Frontend Service - Optional
# ============================================================

ENABLE_INSECURE_MESSAGE_COOKIE=true
FRONTEND_SIGNATURE_VERSION=1


# ============================================================
# TigerBeetle
# ============================================================

TIGERBEETLE_IMAGE=ghcr.io/tigerbeetle/tigerbeetle:0.16.29
TIGERBEETLE_IP=10.5.0.50
TIGERBEETLE_PORT=4342


# ============================================================
# Infrastructure Images
# ============================================================

POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7
KRATOS_IMAGE=oryd/kratos:v1.2.0
NGINX_IMAGE=nginx:1.27-alpine


# ============================================================
# Network / Proxy
# ============================================================

NGINX_CONFIG_FILE=./nginx.production.conf
NGINX_CERTS_DIR=./certs
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
RAFIKI_NETWORK_SUBNET=10.5.0.0/24
RAFIKI_NETWORK_GATEWAY=10.5.0.1

# ============================================================
# Kratos
# ============================================================

KRATOS_CONFIG_FILE=./kratos.production.yml
KRATOS_COOKIE_SECRET=replace-with-at-least-32-character-cookie-secret
KRATOS_CIPHER_SECRET=replace-with-at-least-32-character-cipher-secret
KRATOS_PUBLIC_URL=https://admin.yourdomain.com/kratos/
KRATOS_BROWSER_URL=https://admin.yourdomain.com
KRATOS_LINK_BASE_URL=https://admin.yourdomain.com/kratos
KRATOS_ERROR_UI_URL=https://admin.yourdomain.com/error
KRATOS_SETTINGS_UI_URL=https://admin.yourdomain.com/settings
KRATOS_RECOVERY_UI_URL=https://admin.yourdomain.com/auth/recovery
KRATOS_LOGOUT_RETURN_URL=https://admin.yourdomain.com/auth
KRATOS_LOGIN_UI_URL=https://admin.yourdomain.com/auth/login
KRATOS_SMTP_CONNECTION_URI=smtps://replace-user:replace-password@smtp.example.com:465/?skip_ssl_verify=false
