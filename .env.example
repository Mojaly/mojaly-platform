# Mojaly platform environment template

NODE_ENV=development

# Shared PostgreSQL database for product/control-plane data.
DATABASE_URL=postgres://mojaly:mojaly@localhost:5433/mojaly

# TigerBeetle is the future financial ledger/data-plane.
TIGERBEETLE_CLUSTER_ID=0
TIGERBEETLE_REPLICA_ADDRESSES=3000

# Rafiki/Open Payments integration.
RAFIKI_BACKEND_URL=http://localhost:6000
RAFIKI_ADMIN_GRAPHQL_URL=http://localhost:6001/graphql
RAFIKI_AUTH_SERVER_URL=http://localhost:6006

# Internal service-to-service auth.
INTERNAL_API_KEY=change-me
