# Shared Docker runtime
NODE_ENV=production
NODE_TLS_REJECT_UNAUTHORIZED=1

CORE_IMAGE=ghcr.io/mojaly/mojaly-core:latest
PARTNER_ADAPTER_IMAGE=ghcr.io/mojaly/mojaly-partner-adapter:latest
API_GATEWAY_IMAGE=ghcr.io/mojaly/mojaly-api-gateway:latest
IDP_IMAGE=ghcr.io/mojaly/mojaly-idp:latest

# Postgres
MOJALY_POSTGRES_DB=mojaly
MOJALY_POSTGRES_USER=mojaly
MOJALY_POSTGRES_PASSWORD=replace-with-strong-postgres-password
MOJALY_POSTGRES_HOST=127.0.0.1
MOJALY_POSTGRES_PORT=5433

# Core service
CORE_PORT=5050
CORE_HOST_PORT=5050
PARTNER_ADAPTER_URL=http://partner-adapter:5070
PARTNER_ADAPTER_INTERNAL_API_KEY=replace-with-strong-internal-key
MOJALY_OPEN_PAYMENTS_HOST=https://pay.mojaly.com
MOJALY_WALLET_ADDRESS_BASE_URL=https://pay.mojaly.com
RAFIKI_BACKEND_GRAPHQL_URL=https://pay.mojaly.com/graphql
RAFIKI_AUTH_GRAPHQL_URL=https://auth.mojaly.com/graphql
RAFIKI_AUTH_DOMAIN=https://auth.mojaly.com
RAFIKI_OPERATOR_TENANT_ID=replace-me
RAFIKI_ADMIN_API_SECRET=replace-with-rafiki-admin-secret
RAFIKI_ADMIN_SIGNATURE_VERSION=1
RAFIKI_AUTH_IDENTITY_SERVER_SECRET=replace-with-identity-server-secret
RAFIKI_WEBHOOK_SIGNATURE_SECRET=replace-with-webhook-secret
KRATOS_PUBLIC_URL=https://identity.mojaly.com
KRATOS_ADMIN_URL=http://mojaly-auth-kratos:4434

# Partner adapter service
PARTNER_ADAPTER_PORT=5070
PARTNER_ADAPTER_HOST_PORT=5070
MOJALY_CORE_URL=http://core:5050

# Partner adapter - KCB
KCB_CONSUMER_KEY=
KCB_CONSUMER_SECRET=
KCB_BASE_URL=https://uat.buni.kcbgroup.com/fundstransfer/1.0.0
KCB_AUTH_URL=https://accounts.buni.kcbgroup.com/oauth2
KCB_COMPANY_CODE=
KCB_DEBIT_ACCOUNT_NUMBER=
KCB_TRANSACTION_TYPE=
KCB_CURRENCY=KES
KCB_CALLBACK_URL=

# Partner adapter - Stanbic
STB_BASE_URL=https://sandbox.connect.stanbicbank.co.ke/api/sandbox/eft-payments
STB_AUTH_URL=https://sandbox.connect.stanbicbank.co.ke/api/sandbox/auth/oauth2/token
STB_KEY=
STB_SECRET=

# Partner adapter - Griffin
GRIFFIN_BASE_URL=https://api.griffin.com
GRIFFIN_API_KEY=
GRIFFIN_LEGAL_PERSON_ID=
GRIFFIN_BANK_ACCOUNT_ID=
GRIFFIN_PAYMENT_SCHEME=fps
GRIFFIN_VERIFY_WEBHOOK_SIGNATURES=true

# Partner adapter - MTN MoMo
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CALLBACK_URL=
MTN_TRANSFER_TYPE=

# Partner adapter - Safaricom Daraja
SAFARICOM_BASE_URL=https://sandbox.safaricom.co.ke
SAFARICOM_CONSUMER_KEY=
SAFARICOM_CONSUMER_SECRET=
SAFARICOM_INITIATOR_NAME=
SAFARICOM_SECURITY_CREDENTIAL=
SAFARICOM_SHORTCODE=
SAFARICOM_B2C_COMMAND_ID=BusinessPayment
SAFARICOM_RESULT_URL=
SAFARICOM_TIMEOUT_URL=

# IDP service
IDP_PORT=5080
IDP_HOST_PORT=5080
# API gateway service
API_GATEWAY_PORT=5060
API_GATEWAY_HOST_PORT=5060
CORE_API_URL=http://core:5050
