# Mojaly Kratos
KRATOS_IMAGE=oryd/kratos:v1.2.0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mojaly_kratos

# Use a long random string for cookie secret. Use exactly 32 characters for cipher secret.
KRATOS_COOKIE_SECRET=replace-with-a-long-random-cookie-secret-for-local-dev
KRATOS_CIPHER_SECRET=0123456789abcdef0123456789abcdef

# Local defaults. Replace with production URLs on the VM.
CONSOLE_URL=http://localhost:3000
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434
KRATOS_PUBLIC_PORT=4433
KRATOS_ADMIN_PORT=4434
MAILSLURPER_WEB_PORT=4436
MAILSLURPER_SMTP_PORT=1025

# Use a real SMTP provider in production.
KRATOS_SMTP_CONNECTION_URI=smtp://test:test@mailslurper:1025/?skip_ssl_verify=true


