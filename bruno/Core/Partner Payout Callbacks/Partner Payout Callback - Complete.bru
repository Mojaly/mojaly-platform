meta {
  name: Partner Payout Callback - Complete
  type: http
  seq: 5
}

post {
  url: {{core_base_url}}/partner-payouts/callback
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "paymentIntentId": "{{paymentIntentId}}",
    "adapterPayoutId": "{{adapterPayoutId}}",
    "status": "COMPLETED"
  }
}

