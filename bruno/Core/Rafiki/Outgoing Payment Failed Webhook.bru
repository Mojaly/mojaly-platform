        "value": "1000",
        "assetCode": "GBP",
        "assetScale": 2
      },
      "receiveAmount": {
        "value": "1000",
        "assetCode": "GBP",
        "assetScale": 2
      },
      "sentAmount": {
        "value": "0",
        "assetCode": "GBP",
        "assetScale": 2
      },
      "stateAttempts": 1,
      "createdAt": "2026-08-01T10:00:00.000Z",
      "balance": "0",
      "error": "Receiver rejected payment",
      "metadata": {
