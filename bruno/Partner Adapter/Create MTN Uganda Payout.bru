meta {
  name: Create MTN Uganda Payout
  type: http
  seq: 5
}

post {
  url: {{partner_adapter_base_url}}/payouts
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "paymentId": "payment-mtn-001",
    "partnerCode": "MTN_UG",
    "amount": "50000",
    "assetCode": "UGX",
    "assetScale": 2,
    "destinationType": "mobile_money",
    "destinationAccount": "256771234567",
    "network": "MTN",
    "reference": "MOJALY MTN TEST",
    "customerName": "Jane Test"
  }
}
