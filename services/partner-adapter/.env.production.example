NODE_ENV=production
PORT=5070

# Internal Docker service URL
MOJALY_CORE_URL=http://core:5050
PARTNER_ADAPTER_INTERNAL_API_KEY=replace-with-shared-internal-key

# KCB Buni
KCB_BASE_URL=https://uat.buni.kcbgroup.com/fundstransfer/1.0.0
KCB_AUTH_URL=https://accounts.buni.kcbgroup.com/oauth2
KCB_CONSUMER_KEY=replace-with-kcb-consumer-key
KCB_CONSUMER_SECRET=replace-with-kcb-consumer-secret
KCB_COMPANY_CODE=replace-with-kcb-company-code
KCB_DEBIT_ACCOUNT_NUMBER=replace-with-kcb-debit-account-number
KCB_TRANSACTION_TYPE=replace-with-kcb-transaction-type
KCB_CURRENCY=KES
KCB_CALLBACK_URL=https://partners.mojaly.com/webhooks/kcb

# Griffin
GRIFFIN_BASE_URL=https://api.griffin.com
GRIFFIN_API_KEY=replace-with-griffin-api-key
GRIFFIN_LEGAL_PERSON_ID=replace-with-griffin-legal-person-id
GRIFFIN_BANK_ACCOUNT_ID=replace-with-griffin-bank-account-id
GRIFFIN_PAYMENT_SCHEME=fps
GRIFFIN_VERIFY_WEBHOOK_SIGNATURES=true

# MTN MoMo Disbursement
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=replace-with-mtn-primary-or-secondary-key
MTN_API_USER=replace-with-provisioned-mtn-api-user-uuid
MTN_API_KEY=replace-with-provisioned-mtn-api-key
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CALLBACK_URL=https://partners.mojaly.com/webhooks/mtn
MTN_TRANSFER_TYPE=replace-with-mtn-transfer-type

# Safaricom Daraja B2C
SAFARICOM_BASE_URL=https://sandbox.safaricom.co.ke
SAFARICOM_CONSUMER_KEY=replace-with-safaricom-consumer-key
SAFARICOM_CONSUMER_SECRET=replace-with-safaricom-consumer-secret
SAFARICOM_INITIATOR_NAME=replace-with-initiator-name
SAFARICOM_SECURITY_CREDENTIAL=replace-with-security-credential
SAFARICOM_SHORTCODE=replace-with-shortcode
SAFARICOM_B2C_COMMAND_ID=BusinessPayment
SAFARICOM_RESULT_URL=https://partners.mojaly.com/webhooks/safaricom/result
SAFARICOM_TIMEOUT_URL=https://partners.mojaly.com/webhooks/safaricom/timeout
