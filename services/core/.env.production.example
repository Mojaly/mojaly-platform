NODE_ENV=production
PORT=5050

# Internal Docker service URL
PARTNER_ADAPTER_URL=http://partner-adapter:5070
PARTNER_ADAPTER_INTERNAL_API_KEY=replace-with-shared-internal-key

# Public Mojaly/Open Payments URLs
MOJALY_OPEN_PAYMENTS_HOST=https://pay.mojaly.com
MOJALY_WALLET_ADDRESS_BASE_URL=https://pay.mojaly.com

# Hosted Rafiki URLs
RAFIKI_BACKEND_GRAPHQL_URL=https://pay.mojaly.com/graphql
RAFIKI_AUTH_GRAPHQL_URL=https://auth.mojaly.com/graphql
RAFIKI_AUTH_DOMAIN=https://auth.mojaly.com

# Rafiki signing/admin values
RAFIKI_OPERATOR_TENANT_ID=replace-with-operator-tenant-id
RAFIKI_ADMIN_API_SECRET=replace-with-backend-admin-api-secret
RAFIKI_ADMIN_SIGNATURE_VERSION=1
RAFIKI_AUTH_IDENTITY_SERVER_SECRET=replace-with-auth-identity-server-secret
RAFIKI_WEBHOOK_SIGNATURE_SECRET=replace-with-rafiki-webhook-signature-secret

# Mojaly identity service
KRATOS_PUBLIC_URL=https://auth.mojaly.com
KRATOS_ADMIN_URL=http://mojaly-auth-kratos:4434
