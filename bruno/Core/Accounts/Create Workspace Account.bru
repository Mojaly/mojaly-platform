meta {
  name: Create Workspace Account - Griffin GBP
  type: http
  seq: 1
}

post {
  url: {{core_base_url}}/workspaces/{{workspace_id}}/accounts
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "name": "JanjaPay Griffin GBP",
    "partnerCode": "GRIFFIN",
    "externalPartnerAccountId": "{{griffin_external_account_id}}",
    "assetCode": "GBP"
  }
}
